{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -w @leash/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://leash-ai.onrender.com/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://leash-ai.onrender.com/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://leash-ai.onrender.com/readyz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}