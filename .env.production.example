# ==============================================================================
# Leash Production Environment Configuration
# ==============================================================================

# Server Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Set to true (or the number of reverse proxy hops, e.g. 1) when running behind
# Cloudflare, AWS ALB, Nginx, Render, or Railway reverse proxies.
TRUST_PROXY=true

# Database Connection (PostgreSQL or Neon Serverless)
# - Standard PostgreSQL: postgresql://user:password@host:5432/dbname?sslmode=require
# - Neon Tech: postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Origin of the web dashboard (used for CSRF and Origin header validation)
# Must match your public production frontend URL exactly (e.g. https://leash.yourdomain.com).
WEB_ORIGIN=https://leash.yourdomain.com

# Sessions
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=720
STEP_UP_WINDOW_MINUTES=5

# --- PayPal (backend only; never exposed to agents or browser) ---
# Leash is sandboxed: only "sandbox" is permitted.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# --- Anthropic LLM (backend only) ---
# Required for AI intent verification and policy compiler
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_MODEL_POLICY_COMPILER=claude-3-5-sonnet-20241022
LLM_MODEL_CLASSIFIER=claude-3-5-haiku-20241022
LLM_CLASSIFIER_TIMEOUT_MS=8000
LLM_POLICY_COMPILER_TIMEOUT_MS=60000

# --- Operational Limits ---
APPROVAL_TTL_MINUTES=60
AUTHORIZATION_TTL_MINUTES=30
EVALUATION_TIMEOUT_SECONDS=120
RESERVATION_SWEEP_INTERVAL_SECONDS=30
SANDBOX_MAX_TRANSACTION_MINOR=50000

