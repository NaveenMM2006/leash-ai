{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-API-DOMAIN.com/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://YOUR-API-DOMAIN.com/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://YOUR-API-DOMAIN.com/readyz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

